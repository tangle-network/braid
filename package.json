{
  "name": "@tangle-network/braid",
  "version": "0.1.0",
  "description": "A universal terminal interface for portable agent profiles",
  "type": "module",
  "bin": {
    "braid": "./dist/bin/braid.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/views/headless/protocol.d.ts",
      "import": "./dist/views/headless/protocol.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_LICENSES.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/braid.git"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "capture:w0": "pnpm run build && node scripts/capture-w0.mjs",
    "capture:visual": "pnpm run build && node scripts/capture-visual.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:module-size && pnpm run boundaries && pnpm run dependencies:check && pnpm run attribution && pnpm run licenses:check && pnpm run test",
    "check:module-size": "node scripts/check-module-size.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "dependencies:check": "node scripts/check-dependencies.mjs",
    "attribution": "node scripts/check-attribution.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "test": "node scripts/clean-tests.mjs && tsc -p tsconfig.test.json && node scripts/run-tests.mjs && node scripts/test-module-size.mjs && node scripts/test-release-evidence.mjs",
    "test:unit": "node scripts/run-suite.mjs unit && node scripts/test-release-evidence.mjs",
    "test:contract": "node scripts/run-suite.mjs contract",
    "test:rpc": "pnpm run build && node scripts/test-rpc-packed.mjs",
    "test:virtual-terminal": "node scripts/run-suite.mjs virtual-terminal",
    "test:pty": "pnpm run build && node scripts/test-pty.mjs",
    "test:storage": "node scripts/run-suite.mjs storage",
    "test:security": "node scripts/run-suite.mjs security && pnpm run boundaries",
    "test:performance": "node scripts/run-suite.mjs performance",
    "test:live:bridge": "node scripts/live-required.mjs live-bridge",
    "test:live:tangle": "node scripts/live-required.mjs live-tangle",
    "test:live:supervisor": "node scripts/live-required.mjs live-supervisor",
    "test:live:analysis": "node scripts/live-required.mjs live-analysis",
    "test:eval": "node scripts/live-required.mjs semantic-eval",
    "test:install": "pnpm run build && node scripts/verify-package.mjs",
    "test:package": "pnpm run build && node scripts/verify-package.mjs",
    "pack:check": "pnpm pack --pack-destination .tmp",
    "verify:release": "node scripts/verify-release.mjs",
    "proof:w0": "pnpm run build && node scripts/verify-package.mjs --record artifacts/verification/w0/package-proof.json && node scripts/capture-w0.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.83.0",
    "@tangle-network/agent-eval": "0.139.2",
    "@tangle-network/agent-interface": "0.40.0",
    "@tangle-network/agent-runtime": "0.117.0",
    "@tangle-network/sandbox": "0.15.2",
    "chalk": "5.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.10.1",
    "@xterm/headless": "5.5.0",
    "node-pty": "1.1.0",
    "typescript": "7.0.2"
  }
}
