001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K ├──────────────────────────────────┼───────────────────────┼─────────────────────────────────────────────────────────┤ \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K │ Lowercase                        │ \u001b[38;2;255;205;117m.toLowerCase()\u001b[39m        │ \u001b[38;2;255;205;117mHeLLo WORLD\u001b[39m → \u001b[38;2;255;205;117mhello-world\u001b[39m                               │ \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K └──────────────────────────────────┴───────────────────────┴─────────────────────────────────────────────────────────┘ \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K                                                                                                                        \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[1mEdge cases covered:\u001b[22m empty string (\u001b[38;2;255;205;117m''\u001b[39m → \u001b[38;2;255;205;117m''\u001b[39m), punctuation/whitespace/underscore-only input (→ \u001b[38;2;255;205;117m''\u001b[39m), digits preserved      \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K (\u001b[38;2;255;205;117mRoom 101\u001b[39m → \u001b[38;2;255;205;117mroom-101\u001b[39m), and the original \u001b[38;2;255;205;117mHello world\u001b[39m → \u001b[38;2;255;205;117mhello-world\u001b[39m regression.                                          \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K                                                                                                                        \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[1m\u001b[38;2;119;166;255m\u001b[1mResu"]
